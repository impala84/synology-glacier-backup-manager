# Required: the existing S3 bucket used for this installation.
GBM_BUCKET=example-archive-bucket

# Usually unchanged.
GBM_REMOTE=aws-archive
GBM_RCLONE_CONFIG=/volume1/@rclone/rclone.conf
TZ=Asia/Singapore

# Only behind a trusted reverse proxy (enables X-Forwarded-For / X-Forwarded-Proto).
GBM_TRUST_PROXY=false

# Review these together with the read-only volume mounts in compose.yaml.
GBM_BROWSE_ROOTS=/volume1:/volume3
GBM_SOURCE_MOUNTS=/volume1=/sources/volume1,/volume3=/sources/volume3
